############################################################
# ArtWala Backend Environment Variables (Example Template) #
############################################################
# Copy this file to .env and fill in REAL values. Do NOT commit .env.

########################
# Core Environment
########################
DJANGO_ENV=development            # development | production
DJANGO_SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
DEBUG=false                       # Ignored in production unless DJANGO_ENV!=production

# Hosts & CORS (Development defaults)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

########################
# Database (Dev uses SQLite automatically if DJANGO_ENV=development)
########################
# Option A: Single URL (preferred in many deployments)
# DATABASE_URL=postgres://artwala_user:StrongPassword@localhost:5432/artwala_db

# Option B: Discrete variables
POSTGRES_DB=artwala_db
POSTGRES_USER=artwala_user
POSTGRES_PASSWORD=CHANGE-THIS-PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

########################
# Email (Use provider credentials in production)
########################
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your.email@example.com
EMAIL_HOST_PASSWORD=app-password-here
DEFAULT_FROM_EMAIL=ArtWala <no-reply@artwala.local>

########################
# JWT Lifetimes
########################
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

########################
# Throttling (Adjust down for production)
########################
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour

########################
# Logging
########################
LOG_LEVEL=INFO

########################
# Security / Optional
########################
# CSRF_TRUSTED_ORIGINS=https://artwala.org,https://www.artwala.org
# SECURE_HSTS_SECONDS=31536000

########################
# Production Example (Copy to your server .env and edit)
########################
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=GENERATE-A-64-CHAR-RANDOM-SECRET
# ALLOWED_HOSTS=artwala.org,www.artwala.org
# CORS_ALLOWED_ORIGINS=https://artwala.org,https://www.artwala.org
# CSRF_TRUSTED_ORIGINS=https://artwala.org,https://www.artwala.org
# DATABASE_URL=postgres://artwala_prod:UltraStrongPwd@db-host:5432/artwala_prod
# LOG_LEVEL=INFO
# THROTTLE_ANON_RATE=20/hour
# THROTTLE_USER_RATE=200/hour
# EMAIL_HOST_USER=no-reply@artwala.org
# EMAIL_HOST_PASSWORD=production-app-password
# DEFAULT_FROM_EMAIL=ArtWala <no-reply@artwala.org>

########################
# Future Integrations (Optional)
########################
# SENTRY_DSN=https://<public>@oXXXX.ingest.sentry.io/XXXX
# REDIS_URL=redis://localhost:6379/0
# MEDIA_CDN_DOMAIN=cdn.artwala.org
# AWS_ACCESS_KEY_ID=YOURKEY
# AWS_SECRET_ACCESS_KEY=YOURSECRET
# AWS_STORAGE_BUCKET_NAME=artwala-media

# End of template
